# Copy to .env if you want. Anything already in the environment wins.

# Ollama on this machine. Pull a Gemma model first: ollama pull gemma2:2b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b

# Set to 1 to parse stories with the built-in stand-in instead of Gemma.
# Tests use this path. The altar, photos, and ghost mode still run.
OFRENDA_MOCK_LLM=0

OFRENDA_HOST=127.0.0.1
OFRENDA_PORT=8000
# OFRENDA_DATA_DIR=./data
# OFRENDA_LLM_TIMEOUT=120
